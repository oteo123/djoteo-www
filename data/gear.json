  "policies": [
    {
      "title": "What a night includes",
      "body": "Delivery, setup, and collection anywhere in Central Florida, plus basic tech support to get you running. Gear is tested before it leaves and cleaned between rentals."
    },
    {
      "title": "Rental period",
      "body": "A rental night is a 24-hour period. Gear is delivered before your event and collected the following day. Returns more than an hour past the agreed collection time are charged an additional night."
    },
    {
      "title": "Booking and deposit",
      "body": "A 50% deposit confirms the date. Your card is saved at checkout but nothing is charged until OTEO confirms availability — if the date can't be covered, you are never charged. The balance is due on delivery. Minimum 48 hours notice."
    },
    {
      "title": "Delivery",
      "body": "Delivery, setup and collection are included within 30 miles of Orlando — most vendors in this market charge $40 and up for that. Beyond 30 miles we still deliver across Central Florida, quoted per trip. Minimum order $150. Someone over 18 must be present to receive and return the gear."
    },
    {
      "title": "Security hold",
      "body": "A $500 refundable hold is placed on the card on file for the rental period and released after the gear is returned and inspected. Larger riders may carry a higher hold, agreed in advance."
    },
    {
      "title": "Damage, loss and liability",
      "body": "The renter is responsible for the gear from delivery until collection, including loss, theft and damage beyond normal use, at full replacement cost. No damage waiver is offered on audio equipment. Please keep gear dry, powered from a grounded supply, and out of the rain."
    },
    {
      "title": "Cancellation",
      "body": "Cancel more than 7 days before the date and the deposit is refunded in full. Inside 7 days the deposit is retained, since the gear is held off the calendar for you."
    },
    {
      "title": "Substitutions",
      "body": "If a piece fails between bookings, OTEO will supply an equivalent or better replacement, or refund that item in full. You will be told before delivery, never on the night."
    }
  ],
